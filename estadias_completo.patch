+from __future__ import annotations
+
+import re
+import zipfile
+from io import BytesIO
+
+import pandas as pd
+
+from src.config.settings import ASSETS_DIR
+from src.modules.estadias.repository import read_estadia_positions_period, read_rastreador_period
+
+RODO_WALL_PDF_BACKGROUND_PATH = ASSETS_DIR / "rodo_wall_pdf_background.png"
